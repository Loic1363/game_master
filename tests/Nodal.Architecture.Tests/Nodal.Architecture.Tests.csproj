<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NodalTargetFramework)</TargetFramework>
    <RootNamespace>Nodal.Architecture.Tests</RootNamespace>
    <AssemblyName>Nodal.Architecture.Tests</AssemblyName>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nodal.Foundation\Nodal.Foundation.csproj" />
    <ProjectReference Include="..\..\src\Nodal.Content\Nodal.Content.csproj" />
    <ProjectReference Include="..\..\src\Nodal.Circuit\Nodal.Circuit.csproj" />
    <ProjectReference Include="..\..\src\Nodal.Simulation\Nodal.Simulation.csproj" />
    <ProjectReference Include="..\..\src\Nodal.Editor\Nodal.Editor.csproj" />
    <ProjectReference Include="..\..\src\Nodal.Cli\Nodal.Cli.csproj" />
  </ItemGroup>

</Project>
